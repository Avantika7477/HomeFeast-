PORT=5000
# Direct connection to primary Atlas shard (recommended on Windows):
MONGO_URI=mongodb://USER:PASS@ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017/Homemade?ssl=true&authSource=admin&directConnection=true&retryWrites=true&w=majority
# SRV (optional — often fails on Windows DNS):
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/Homemade?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
