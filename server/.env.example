PORT=5000
# Windows local: directConnection to any shard — server auto-picks the writable primary (00/01/02)
MONGO_URI=mongodb://USER:PASS@ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/Homemade?ssl=true&authSource=admin&directConnection=true&retryWrites=true&w=majority
# Render/cloud (preferred): use SRV so Atlas always finds the primary
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/Homemade?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
